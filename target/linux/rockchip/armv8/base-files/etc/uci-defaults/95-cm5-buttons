#!/bin/sh
# Orange Pi CM5 Base: ensure button event log exists; install scripts if package missing.

case "$(board_name)" in
xunlong,orangepi-cm5-base) ;;
*) exit 0 ;;
esac

touch /var/log/button-events.log
chmod 0644 /var/log/button-events.log 2>/dev/null

[ -x /etc/rc.button/wps ] && [ -x /etc/rc.button/BTN_2 ] && exit 0

cat > /etc/rc.button/wps <<'EOF'
#!/bin/sh

state="/var/run/button-${BUTTON}.state"
log="/var/log/button-events.log"

case "$ACTION" in
pressed)
	echo pressed > "$state"
	logger -t button "USERKEY/WPS pressed button=$BUTTON seen=$SEEN"
	for dir in /var/run/hostapd-*; do
		[ -d "$dir" ] || continue
		for iface in "$dir"/*; do
			[ -S "$iface" ] || continue
			hostapd_cli -p "$dir" -i "${iface##*/}" wps_pbc 2>/dev/null &
		done
	done
	;;
released)
	echo released > "$state"
	logger -t button "USERKEY/WPS released button=$BUTTON seen=$SEEN"
	;;
esac

echo "$(date '+%Y-%m-%d %H:%M:%S') $BUTTON $ACTION seen=${SEEN:-0}" >> "$log"
return 0
EOF

cat > /etc/rc.button/BTN_2 <<'EOF'
#!/bin/sh

state="/var/run/button-${BUTTON}.state"
log="/var/log/button-events.log"

case "$ACTION" in
pressed)
	echo pressed > "$state"
	logger -t button "MaskROM pressed button=$BUTTON seen=$SEEN"
	;;
released)
	echo released > "$state"
	logger -t button "MaskROM released button=$BUTTON seen=$SEEN"
	;;
esac

echo "$(date '+%Y-%m-%d %H:%M:%S') $BUTTON $ACTION seen=${SEEN:-0}" >> "$log"
return 0
EOF

chmod 0755 /etc/rc.button/wps /etc/rc.button/BTN_2
touch /var/log/button-events.log
chmod 0644 /var/log/button-events.log

exit 0
