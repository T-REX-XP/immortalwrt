#!/bin/sh
# CM5 Base: LAN1 = eth1/green:lan-0, LAN2 = eth2/green:lan-1 (carrier silkscreen).
# WAN/LAN0 PWM LEDs need PWM_POLARITY_INVERTED in DTS (patch 9980); UCI default=0 = off.

[ -f /etc/.cm5_leds_fixed_v5 ] && exit 0
[ "$(board_name)" = "xunlong,orangepi-cm5-base" ] || exit 0

. /lib/functions.sh

fix_netdev_led() {
	local cfg="$1"
	local sysfs="$2"
	local dev="$3"

	[ -n "$cfg" ] || return 0
	uci -q batch <<-EOF
		set system.$cfg.sysfs='$sysfs'
		set system.$cfg.dev='$dev'
		set system.$cfg.trigger='netdev'
		set system.$cfg.mode='link'
		set system.$cfg.default='0'
	EOF
}

idx=0
while uci -q get "system.@led[$idx]" >/dev/null 2>&1; do
	case "$(uci -q get "system.@led[$idx].name")" in
		LAN1) fix_netdev_led "@led[$idx]" "green:lan-0" "eth1" ;;
		LAN2) fix_netdev_led "@led[$idx]" "green:lan-1" "eth2" ;;
		WAN) fix_netdev_led "@led[$idx]" "green:wan" "eth0" ;;
		STATUS)
			uci -q batch <<-EOF
				set system.@led[$idx].sysfs='red:status'
				set system.@led[$idx].trigger='heartbeat'
				set system.@led[$idx].default='0'
				delete system.@led[$idx].dev
				delete system.@led[$idx].mode
			EOF
			;;
	esac
	idx=$((idx + 1))
done

uci commit system
touch /etc/.cm5_leds_fixed_v5
/etc/init.d/led restart 2>/dev/null

exit 0
