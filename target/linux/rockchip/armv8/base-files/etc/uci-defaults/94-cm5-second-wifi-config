#!/bin/sh
# Runs once on first boot (after defaults). Helps when USB radios appear after /sbin/wifi config in early init.

case "$(board_name 2>/dev/null)" in
xunlong,orangepi-cm5-base) ;;
*) exit 0 ;;
esac

/sbin/wifi config 2>/dev/null

# LuCI only shows Network→Wireless when wireless has a wifi-device section (see luci-mod-network menu.d).
# With USB-only Wi-Fi, first boot can still have no phy; add disabled stub wireless.cm5_placeholder so the
# menu exists until a real wiphy appears (then hotplug /etc/init.d/reload-sdio-wifi removes it).
if uci -q show wireless 2>/dev/null | grep -q '=wifi-device'; then
	exit 0
fi

uci -q batch <<-EOF
	set wireless.cm5_placeholder=wifi-device
	set wireless.cm5_placeholder.type='mac80211'
	set wireless.cm5_placeholder.path='placeholder/no-radio'
	set wireless.cm5_placeholder.band='2g'
	set wireless.cm5_placeholder.channel='1'
	set wireless.cm5_placeholder.htmode='NOHT'
	set wireless.cm5_placeholder.country='US'
	set wireless.cm5_placeholder.disabled='1'
	commit wireless
EOF

exit 0
