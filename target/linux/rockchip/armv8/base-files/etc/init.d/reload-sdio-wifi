#!/bin/sh /etc/rc.common

START=99

boot() {
	case "$(board_name)" in
	9tripod,x3568-v4)
		( sleep 120s; wifi; ) &
		;;
	ariaboard,photonicat)
		( modprobe ath10k_sdio; sleep 5s; wifi config; wifi; ) &
		;;
	armsom,sige3)
		( sleep 50s; wifi; ) &
		;;
	armsom,sige7)
		( sleep 100s; wifi; ) &
		;;
	xunlong,orangepi-cm5-base)
		# USB Wi-Fi often enumerates after first-boot uci-defaults; ieee80211 hotplug can miss it.
		# Retry once wiphy exists: drop LuCI stub cm5_placeholder and apply CM5 hotspot defaults.
		(
			sleep 25
			. /lib/cm5-base-wifi.sh
			[ "$(board_name)" = "xunlong,orangepi-cm5-base" ] || exit 0
			[ -n "$(ls /sys/class/ieee80211 2>/dev/null)" ] || exit 0
			cm5_drop_wireless_placeholder
			cm5_autoconfig_hotspot
		) &
		;;
	esac
}

