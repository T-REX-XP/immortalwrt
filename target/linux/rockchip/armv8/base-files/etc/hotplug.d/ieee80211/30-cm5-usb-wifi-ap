#!/bin/sh

[ "$ACTION" = "add" ] || exit 0

board="$(board_name 2>/dev/null)"
[ "$board" = "xunlong,orangepi-cm5-base" ] || exit 0

. /lib/cm5-base-wifi.sh

logger -t cm5-wifi "ieee80211 $ACTION: scheduling USB Wi-Fi autoconfig"

(
	sleep 3

	cm5_drop_wireless_placeholder
	cm5_autoconfig_hotspot
) &
