#!/bin/sh

# Retry MediaTek USB WiFi installer mode (0e8d:2870 etc.) automatically on Orange Pi CM5 Base.

case "$(board_name 2>/dev/null)" in
xunlong,orangepi-cm5-base) ;;
*) exit 0 ;;
esac

stamp=/tmp/usbmode_cm5_stamp

run_usbmode_twice() {
	logger -t usbmode-cm5 "$1 - running usbmode"
	/sbin/usbmode -s
	sleep 2
	/sbin/usbmode -s
}

# Returns 0 when an installer-mode MediaTek USB id is present on the bus (any line).
have_mtk_installer() {
	lsusb 2>/dev/null | grep -Eq 'ID 0e8d:(2870|7109|0002)'
}

# Runtime USB IDs after switching (and some dongles that enumerate directly).
have_mtk_wlan() {
	lsusb 2>/dev/null | grep -Eq 'ID 0e8d:(7612|7615|7610|7632|7663|7921|7925|7936|7961)' && return 0
	for phy in /sys/class/ieee80211/*; do
		[ -e "$phy" ] || continue
		case "$(readlink -f "$phy/device" 2>/dev/null)" in
			*/usb*) return 0 ;;
		esac
	done
	return 1
}

attempt() {
	tag="$1"

	have_mtk_installer || return 1

	now=$(date +%s)
	last=0
	[ -f "$stamp" ] && last=$(cat "$stamp")

	if [ "$last" -gt 0 ] && [ "$((now - last))" -lt 8 ]; then
		return 0
	fi

	echo "$now" >"$stamp"

	run_usbmode_twice "$tag"
	return 0
}

case "$1" in
hotplug)
	# USB bursts many add events on one plug; throttle with attempt()'s stamp.
	(sleep 2; attempt "hotplug") &
	;;
boot-loop)
	# Let VBUS / hub settle; then retry switching much sooner than the old "sleep 5 first".
	sleep 3
	have_mtk_wlan && exit 0
	attempt "boot-pass-0" || true
	i=0
	while [ "$i" -lt 36 ]; do
		have_mtk_wlan && exit 0
		i=$((i + 1))
		sleep 5
		attempt "boot-pass-$i" || true
	done
	;;
esac

exit 0
