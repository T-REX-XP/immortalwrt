part uuid ${devtype} ${devnum}:2 uuid

if test $soc = 'rk3308'; then
	serial_addr=',0xff0c0000'; serial_port='ttyS2';
elif test $soc = 'rk3328'; then
	serial_addr=',0xff130000'; serial_port='ttyS2';
elif test $soc = 'rk3399'; then
	serial_addr=',0xff1a0000'; serial_port='ttyS2';
elif test $soc = 'rk3528'; then
	serial_addr=',0xff9f0000'; serial_port='ttyS0';
elif test $soc = 'rk3568'; then
	serial_addr=',0xfe660000'; serial_port='ttyS2';
elif test $soc = 'rk3576'; then
	serial_addr=',0x2ad40000'; serial_port='ttyS0';
elif test $soc = 'rk3588'; then
	serial_addr=',0xfeb50000'; serial_port='ttyS2';
elif test $soc = 'rk3588s'; then
	serial_addr=',0xfeb50000'; serial_port='ttyS2';
fi

# MT7612U (and similar) installer CD-ROM (0e8d:2870): ignore so usbmode can switch to wlan.
# Required when usb-storage is built-in (CONFIG_USB_STORAGE=y); modules.d quirks do not apply.
# ttyS2 (J3 debug header) is reserved for mcudd @ 115200 — no kernel serial console.
# For bench UART debug: fw_setenv bootargs "coherent_pool=2M console=tty1 earlycon=uart8250,mmio32,0xfeb50000 console=ttyS2,1500000n8 root=PARTUUID=${uuid} rw rootwait usb-storage.quirks=0e8d:2870:i"
setenv bootargs "coherent_pool=2M console=tty1 root=PARTUUID=${uuid} rw rootwait usb-storage.quirks=0e8d:2870:i";

load ${devtype} ${devnum}:1 ${kernel_addr_r} kernel.img

bootm ${kernel_addr_r}
