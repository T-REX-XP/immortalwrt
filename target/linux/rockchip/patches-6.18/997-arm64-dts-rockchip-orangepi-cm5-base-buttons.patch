From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenWrt <openwrt@openwrt.org>
Date: Sat, 20 Jun 2026 00:00:00 +0000
Subject: arm64: dts: rockchip: Orange Pi CM5 Base USERKEY + MaskROM buttons

Enable the carrier USERKEY (gpio-keys → KEY_WPS_BUTTON) and add an adc-keys
node for the MaskROM button on SARADC channel 0 (Rockchip adc-keys pattern
used on other RK3588 boards). Validate thresholds on real hardware if events
are missing.

---
--- a/arch/arm64/boot/dts/rockchip/rk3588s-orangepi-cm5-base.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-orangepi-cm5-base.dts
@@ -36,6 +36,22 @@
 		stdout-path = "serial2:1500000n8";
 	};
 
+	key-adc-mask {
+		compatible = "adc-keys";
+		io-channels = <&saradc 0>;
+		io-channel-names = "buttons";
+		keyup-threshold-microvolt = <1800000>;
+		poll-interval = <100>;
+
+		button-maskrom {
+			label = "maskrom";
+			linux,code = <BTN_2>;
+			press-threshold-microvolt = <1750000>;
+		};
+	};
+
 	gpio-keys {
 		compatible = "gpio-keys";
 		pinctrl-names = "default";
 		pinctrl-0 = <&key1_pin>;
 
-		button {
+		userkey {
 			debounce-interval = <50>;
 			gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_LOW>;
 			label = "USERKEY";
@@ -383,6 +399,11 @@
 	};
 };
 
+&saradc {
+	status = "okay";
+	vref-supply = <&avcc_1v8_s0>;
+};
+
 &vp0 {
 	vp0_out_hdmi0: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
 		reg = <ROCKCHIP_VOP2_EP_HDMI0>;
